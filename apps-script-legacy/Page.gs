  "</head>",
  "<body>",
  "<header>",
  "  <div class=\"title\">COT MARKET COMMAND CENTRE</div>",
  "  <div id=\"chips\"></div>",
  "</header>",
  "<nav id=\"nav\"></nav>",
  "<div id=\"ctl\"></div>",
